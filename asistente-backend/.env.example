# API Key de Google Gemini (obtener en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Token secreto para autenticación Bearer (cámbialo en producción)
API_SECRET_TOKEN=asistente-mayores-token-2024

# Clave secreta para firmar tokens JWT (cámbialo en producción)
JWT_SECRET=asistente-mayores-jwt-secret-2024-cambiar-en-produccion

# URL de base de datos (opcional, por defecto usa SQLite)
# DATABASE_URL=sqlite:///./asistente_mayores.db
# Para PostgreSQL en producción:
# DATABASE_URL=postgresql://user:password@host:port/database
